<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup AND device-to-device transfer. Offline world data may
     transfer; social credentials reside in noBackupFilesDir, and consent
     cannot follow to another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="trialum_social_v1.xml"/>
        <exclude domain="sharedpref" path="trialum_push_v1.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="trialum_social_v1.xml"/>
        <exclude domain="sharedpref" path="trialum_push_v1.xml"/>
    </device-transfer>
</data-extraction-rules>
