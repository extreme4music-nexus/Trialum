# Copy to .env and keep private. Never commit .env or real credentials.
# Use a random password: openssl rand -hex 32
PG_PASSWORD=REPLACE_WITH_RANDOM_64_HEX_CHARS
# Only HOST LOOPBACK port is published via Docker; no firewall/router change.
TRIALUM_HEALTH_PASSWORD=REPLACE_WITH_SECOND_DIFFERENT_RANDOM_64_HEX_CHARS
TRIALUM_HOST_PORT=8787

# Leave social endpoints disabled until SQL provisioning and owner security gate.
TRIALUM_SOCIAL_ENABLED=false
TRIALUM_APP_PASSWORD=REPLACE_WITH_THIRD_DIFFERENT_RANDOM_64_HEX_CHARS

# 1.5.6-D: explicit separate opt-in after backed-up 004 migration and private HTTPS QA.
TRIALUM_SHARED_ENABLED=false
# LW-A: keep OFF until PostgreSQL 006 is backed up, applied and restored in test DB.
TRIALUM_PRESENCE_ENABLED=false
# Private-room ephemeral pet speech, no database writes, only after independent QA.
TRIALUM_PLAYGROUND_AI_ENABLED=false

# 1.5.6-E: separate OFF-by-default encrypted messaging.
TRIALUM_MESSAGES_ENABLED=false
TRIALUM_DATA_KEY=REPLACE_WITH_FOURTH_UNIQUE_RANDOM_64_HEX_CHARS
TRIALUM_FREE_TEXT_ENABLED=false
# No push without explicit consent AND Firebase project + mounted secret.
TRIALUM_PUSH_ENABLED=false
TRIALUM_FCM_PROJECT_ID=
